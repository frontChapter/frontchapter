{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": ["next/core-web-vitals", "eslint:recommended", "plugin:prettier/recommended"],
  "plugins": ["prettier"],
  "rules": {
    "prettier/prettier": "error"
  },
  "overrides": [
    {
      "files": ["supabase/functions/**/*.ts"],
      "env": { "browser": false },
      "globals": {
        "Deno": "readonly",
        "EdgeRuntime": "readonly"
      }
    }
  ]
}
